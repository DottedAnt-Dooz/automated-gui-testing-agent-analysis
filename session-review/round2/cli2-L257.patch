+function Test-FilePrefix {
+    [CmdletBinding()]
+    param(
+        [Parameter(Mandatory)] [string] $Path,
+        [Parameter(Mandatory)] [byte[]] $ExpectedBytes
+    )
+
+    if (-not (Test-Path -LiteralPath $Path)) { return $false }
+    $stream = [System.IO.File]::OpenRead($Path)
+    try {
+        if ($stream.Length -lt $ExpectedBytes.Length) { return $false }
+        $actual = New-Object byte[] $ExpectedBytes.Length
+        [void] $stream.Read($actual, 0, $actual.Length)
+        for ($i = 0; $i -lt $ExpectedBytes.Length; $i++) {
+            if ($actual[$i] -ne $ExpectedBytes[$i]) { return $false }
+        }
+        return $true
+    }
+    finally {
+        $stream.Dispose()
+    }
+}
+
+function Invoke-ClickWordBrowse {
